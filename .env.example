# GCP Configuration
GCP_PROJECT_ID=thtask
GCP_REGION=eu
BQ_DATASET_RAW=recruitment_raw
BQ_DATASET_ANALYTICS=recruitment_analytics

# Authentication: run `gcloud auth application-default login` before using ingestion scripts.
# Ingestion scripts use argparse for --project, not env vars.

# dbt Profile
DBT_PROFILES_DIR=~/.dbt
DBT_TARGET=prod
